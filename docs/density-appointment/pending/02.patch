diff --git a/src/presentation/documents/AvsAppointmentEditor.tsx b/src/presentation/documents/AvsAppointmentEditor.tsx
new file mode 100644
index 0000000000000000000000000000000000000000..37ec0e6c94092e148cd296ae15857c7d52169732
