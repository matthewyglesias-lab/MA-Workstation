+import { describe, expect, it } from "vitest";
+import { readFileSync, readdirSync } from "node:fs";
+const root = new URL("../../src/presentation/", import.meta.url);
+const text = (path: string) => readFileSync(new URL(path, root), "utf8");
+
+describe("compact presentation source contracts (not browser geometry)", () => {
+  it("has one owner for density dimensions, not competing late overrides", () => {
+    const owners = readdirSync(new URL("lightfully/", root)).filter(p=>p.endsWith(".css"))
+      .filter(p=>/--lf-(control-height|control-padding|control-font|control-line|row-gap|section-gap)\s*:/.test(text(`lightfully/${p}`)));
+    expect(owners).toEqual(["controls.css"]);
+    expect(text("lightfully/ipmg-refinement.css")).not.toContain("data-lf-density=compact");
+    expect(text("lightfully/lightfully-shell.css")).not.toContain("data-lf-density=compact");
+  });
+  it("reduces real control padding and line height, not only min-height", () => {
+    const controls=text("lightfully/controls.css");
+    expect(controls).toContain("--lf-control-height: 34px");
+    expect(controls).toContain("--lf-control-padding: 6px 10px");
+    expect(controls).toContain("--lf-control-line: 20px");
+    expect(20+6*2+2).toBe(34);
+    expect(controls).toContain("padding: var(--lf-control-padding)");
+    expect(controls).toContain("var(--lf-control-font)/var(--lf-control-line)");
+    expect(controls).toContain("height: var(--lf-control-height)");
+  });
+  it("keeps optional roomier preference and guided targets", () => {
+    const controls=text("lightfully/controls.css");
+    expect(controls).toContain("data-lf-density=comfortable");
+    expect(controls).toContain("--lf-control-height: 44px");
+    expect(text("lightfully/WorkspaceTools.tsx")).toContain('=== "comfortable" ? "comfortable" : "compact"');
+  });
+  it("keeps density out of the patient print stylesheet", () => {
+    const print=text("documents/injection-avs.css");
+    expect(print).not.toContain("data-lf-density");
+    expect(print).not.toContain("var(--lf-control");
+    expect(print).toContain("font-size: 14.25px !important");
+    expect(print).toContain("height: 22px; border-bottom");
+  });
+  it("owns preview rows in shell-layout instead of a legacy second row", () => {
+    expect(text("tebra-workstation.css")).not.toMatch(/\.cd2004-transaction-window(?:\.has-document-split)?\s*\{/);
+    expect(text("lightfully/shell-layout.css")).toContain("grid-template-rows: minmax(0,1fr)");
+  });
+  it("does not install another global listener for the appointment editor", () => {
+    const editor=text("documents/AvsAppointmentEditor.tsx");
+    expect(editor).not.toMatch(/addEventListener|localStorage|sessionStorage|window\.print/);
+    expect(editor).toContain("WorkstationDateField");
+    expect(editor).toContain("fieldset disabled={locked || disabled}");
+  });
+});
