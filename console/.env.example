# Explicit localhost-only synthetic demonstration. No patient data.
CONSOLE_MODE=demo
AUTH_MODE=pin
# Fictional local account: staff code demo / PIN 123456
HOST=127.0.0.1
PORT=3100
CLINIC_ID=11111111-1111-4111-8111-111111111111
CLINIC_TIMEZONE=America/Los_Angeles
# Production: CONSOLE_MODE=sql, NODE_ENV=production, HOST=0.0.0.0
# Production PIN: AUTH_MODE=pin; PUBLIC_ORIGIN=https://<app>.azurewebsites.net
# Staff enrollment: npm run staff:manage (separate SQL admin identity)
# Optional Microsoft staff sign-in: AUTH_MODE=entra and ENTRA_* below
# ENTRA_TENANT_ID=<tenant UUID>
# ENTRA_API_CLIENT_ID=<API registration UUID; v2 token audience>
# ENTRA_WEB_CLIENT_ID=<SPA registration UUID>
# SQL_SERVER=<server>.database.windows.net
# SQL_DATABASE=clinic-console
# SQL_AUTH=azure-active-directory-default
# SQL_MANAGED_IDENTITY_CLIENT_ID=<optional user-assigned identity client UUID>
# Render: origin comes from RENDER_EXTERNAL_URL unless PUBLIC_ORIGIN is set.
# SQL_AUTH=azure-active-directory-service-principal-secret
# SQL_TENANT_ID=<Entra directory UUID>
# SQL_CLIENT_ID=<runtime app registration client UUID>
# SQL_CLIENT_SECRET=<set privately in Render; never commit>
# SQL_POOL_MAX=4
# SQL username/password authentication is accepted ONLY for a non-production, loopback test server.
