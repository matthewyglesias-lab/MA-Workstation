{
  "name": "@ipmg/clinic-console",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k 'npm:dev:api' 'npm:dev:web'",
    "dev:api": "tsx watch src/server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/server/main.js",
    "test": "vitest run",
    "test:sql": "tsx tests/sql.integration.ts",
    "db:migrate": "tsx src/server/platform/migrate.ts",
    "check": "npm run build && npm test",
    "format": "prettier --write src tests *.ts *.json docs README.md",
    "format:check": "prettier --check src tests *.ts *.json docs README.md",
    "test:browser": "playwright test",
    "build:preview": "vite build --config vite.preview.config.ts && node scripts/package-preview.mjs",
    "staff:manage": "tsx src/server/platform/manage-staff.ts"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.21.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.3",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.12.4",
    "jose": "^6.2.12",
    "mssql": "^12.7.2",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/mssql": "^12.3.0",
    "@types/node": "^26.5.1",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
